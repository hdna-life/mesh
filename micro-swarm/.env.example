# Copy to .env; never paste secrets into chat or commit them.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Required confirmation: this account is on Workers Free, with no paid overage.
CLOUDFLARE_WORKERS_FREE=false
# Durable local per-UTC-day reservation. Other clients are not tracked.
MAX_DAILY_NEURONS=1000
MAX_BATCH_CALLS=12
PYTHON=.venv/bin/python
